{
  "name": "hls stream",
  "private": true,
  "scripts": {
    "start": "turbo run start",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "add:api": "pnpm --filter api add",
    "add:ui": "pnpm --filter ui add",
    "add:email": "pnpm --filter email add",
    "add:utils": "pnpm --filter utils add",
    "add:env": "pnpm --filter env add",
    "add:auth": "pnpm --filter auth add",
    "add:esconfig": "pnpm --filter esconfig add",
    "add:tsconfig": "pnpm --filter tsconfig add",
    "deploy:prod": "node --env-file=.env.production.local scripts/sst.mjs deploy prod",
    "deploy:dev": "node --env-file=.env.development.local scripts/sst.mjs deploy dev",
    "remove:prod": "node --env-file=.env.production.local scripts/sst.mjs remove prod",
    "remove:dev": "node --env-file=.env.development.local scripts/sst.mjs remove dev"
  },
  "dependencies": {
    "sst": "4.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "serverless": "3",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-esbuild": "^1.57.1",
    "turbo": "^2.9.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.58.0"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  }
}
